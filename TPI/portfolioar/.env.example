# Usar SQLite para desarrollo local (no necesita SQL Server)
USE_SQLITE=True

# Configuración de Base de Datos (solo necesario si USE_SQLITE=False)
DB_NAME=portfolioar_db
DB_USER=sa
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=1433

# Configuración de Django
DJANGO_SECRET_KEY=tu_clave_secreta_aqui
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Credenciales IOL (las mismas con las que ingresás a invertironline.com)
IOL_USER=tu_email@ejemplo.com
IOL_PASSWORD=tu_contraseña_iol
