classDiagram
    direction LR
    class User {
        username
        email
        password
        first_name
        last_name
        is_active
        phone
        birthdate
    }
    class Sector {
        name
        description
        primary
    }
    class Broker {
        name
        link
    }
    class Stock {
        ticker
        company_name
        tipo
        trading_currency
        cedear_kind
        issuer_type
        rate_reference
        payment_style
        instrument_family
        underlying_ticker
        classification_source
        classification_date
        classification_manual
    }
    class Position {
        status
        opened_at
    }
    class Lot {
        amount
        price_local
        price_usd
        purchased_at
        purchase_currency
        fees
        price_input_currency
        price_origin
        price_source
        price_quote_date
        quote_currency
        quote_unit
        ccl_rate
        ccl_date
        ccl_source
    }
    class Sale {
        amount
        price_local
        price_usd
        sold_at
        sell_currency
        realized_pnl_ars
        realized_pnl_usd
        price_input_currency
        price_origin
        price_source
        price_quote_date
        quote_currency
        quote_unit
        ccl_rate
        ccl_date
        ccl_source
    }
    class SaleLot {
        amount_consumed
        cost_price_local
        cost_price_usd
    }
    class CashPosition {
        currency
        amount
        description
        created_at
    }
    class CashTransaction {
        currency
        amount
        tipo
        created_at
    }
    class Alert {
        name
        is_active
        created_at
    }
    class AlertCondition {
        operator
        threshold_value
    }
    class TechnicalIndicator {
        name
        description
        period
    }
    class AlertTrigger {
        trigger_datetime
        ai_recommendation
    }

    User "1" --> "0..*" Position
    User "1" --> "0..*" CashPosition
    User "1" --> "0..*" CashTransaction
    User "1" --> "0..*" Alert
    Sector "0..1" --> "0..*" Stock
    Stock "1" --> "0..*" Position
    Stock "1" --> "0..*" Alert
    Broker "1" --> "0..*" Position
    Position "1" --> "1..*" Lot
    Position "1" --> "0..*" Sale
    Sale "1" --> "1..*" SaleLot : consume por FIFO
    Lot "1" --> "0..*" SaleLot
    Position "0..1" --> "0..*" CashTransaction
    Lot "0..1" --> "0..*" CashTransaction
    Sale "0..1" --> "0..*" CashTransaction
    Alert "0..*" --> "1..*" AlertCondition
    TechnicalIndicator "1" --> "0..*" AlertCondition
    Alert "1" --> "0..*" AlertTrigger
