#:kivy 2.0

#:set COLOR_BG       (0.10, 0.10, 0.12, 1)
#:set COLOR_DISPLAY  (0.06, 0.06, 0.08, 1)
#:set COLOR_OP       (1.00, 0.62, 0.04, 1)
#:set COLOR_FUNC     (0.22, 0.22, 0.26, 1)
#:set COLOR_NUM      (0.18, 0.18, 0.22, 1)
#:set COLOR_EQUAL    (1.00, 0.62, 0.04, 1)
#:set COLOR_PRESS    (0.90, 0.55, 0.02, 1)
#:set COLOR_TEXT     (1,    1,    1,    1)
#:set COLOR_DARK_TXT (0.12, 0.12, 0.14, 1)

<CalcButton@Button>:
    bg_color:      COLOR_NUM
    font_size:     dp(26)
    bold:          True
    color:         COLOR_TEXT
    background_normal:  ''
    background_color:   self.bg_color
    size_hint:     (1, 1)
    canvas.before:
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos:  self.pos
            size: self.size
            radius: [dp(16)]

<CalculatorLayout>:
    orientation: 'vertical'
    spacing:     dp(8)
    padding:     dp(12)

    canvas.before:
        Color:
            rgba: COLOR_BG
        Rectangle:
            pos:  self.pos
            size: self.size

    # ── Display ───────────────────────────────────────────────────────────────
    BoxLayout:
        size_hint_y: 0.50
        padding:     [dp(16), dp(8), dp(16), dp(0)]

        canvas.before:
            Color:
                rgba: COLOR_DISPLAY
            RoundedRectangle:
                pos:  self.pos
                size: self.size
                radius: [dp(20)]

        Label:
            id:            display
            text:          '0'
            font_size:     dp(56)
            bold:          True
            color:         COLOR_TEXT
            halign:        'right'
            valign:        'middle'
            text_size:     self.size
            padding:       (dp(8), 0)
            shorten:       True
            shorten_from:  'left'

    # ── Row 1: C  +/-  %  ÷ ──────────────────────────────────────────────────
    GridLayout:
        cols:        4
        size_hint_y: None
        height:      dp(72)
        spacing:     dp(8)

        CalcButton:
            text:     'C'
            bg_color: COLOR_FUNC
            on_press: root.button_press('C')

        CalcButton:
            text:     '+/-'
            bg_color: COLOR_FUNC
            on_press: root.button_press('+/-')

        CalcButton:
            text:     '%'
            bg_color: COLOR_FUNC
            on_press: root.button_press('%')

        CalcButton:
            text:     '÷'
            bg_color: COLOR_OP
            on_press: root.button_press('÷')

    # ── Row 2: 7  8  9  × ────────────────────────────────────────────────────
    GridLayout:
        cols:        4
        size_hint_y: None
        height:      dp(72)
        spacing:     dp(8)

        CalcButton:
            text:     '7'
            on_press: root.button_press('7')

        CalcButton:
            text:     '8'
            on_press: root.button_press('8')

        CalcButton:
            text:     '9'
            on_press: root.button_press('9')

        CalcButton:
            text:     '×'
            bg_color: COLOR_OP
            on_press: root.button_press('×')

    # ── Row 3: 4  5  6  − ────────────────────────────────────────────────────
    GridLayout:
        cols:        4
        size_hint_y: None
        height:      dp(72)
        spacing:     dp(8)

        CalcButton:
            text:     '4'
            on_press: root.button_press('4')

        CalcButton:
            text:     '5'
            on_press: root.button_press('5')

        CalcButton:
            text:     '6'
            on_press: root.button_press('6')

        CalcButton:
            text:     '−'
            bg_color: COLOR_OP
            on_press: root.button_press('-')

    # ── Row 4: 1  2  3  + ────────────────────────────────────────────────────
    GridLayout:
        cols:        4
        size_hint_y: None
        height:      dp(72)
        spacing:     dp(8)

        CalcButton:
            text:     '1'
            on_press: root.button_press('1')

        CalcButton:
            text:     '2'
            on_press: root.button_press('2')

        CalcButton:
            text:     '3'
            on_press: root.button_press('3')

        CalcButton:
            text:     '+'
            bg_color: COLOR_OP
            on_press: root.button_press('+')

    # ── Row 5: 0 (wide)  .  ⌫  = ─────────────────────────────────────────────
    GridLayout:
        cols:        4
        size_hint_y: None
        height:      dp(72)
        spacing:     dp(8)

        CalcButton:
            text:     '0'
            on_press: root.button_press('0')

        CalcButton:
            text:     '.'
            on_press: root.button_press('.')

        CalcButton:
            text:     '⌫'
            bg_color: COLOR_FUNC
            on_press: root.button_press('⌫')

        CalcButton:
            text:     '='
            bg_color: COLOR_EQUAL
            color:    COLOR_DARK_TXT
            on_press: root.button_press('=')

    Widget:
        size_hint_y: 1
